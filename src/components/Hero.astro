---
import EncryptedText from "@/components/EncryptedText.astro"
import Nav from "@/components/Nav.astro"
import type { SiteMode } from "@/lib/mode"

interface Props {
  mode: SiteMode
}

const { mode } = Astro.props

const stats = {
  frontend: [
    { value: "847", label: "PRs reviewed on a Friday" },
    { value: "12", label: "Rebrands survived" },
  ],
  web3: [
    { value: "3am", label: "Mainnet launch time" },
    { value: "∞", label: "console.logs deleted" },
  ],
  ai: [
    { value: "1.4M", label: "Lines of code (net negative)" },
    { value: "304", label: "Bugs marked won't fix" },
  ],
} satisfies Record<SiteMode, { value: string; label: string }[]>

const copy = {
  web3: {
    sidebarLabel: "Frontend · DeFi · Systems",
    heading: [
      "Building the systems behind",
      "DeFi, agentic trading and",
      "autonomous software.",
    ],
  },
  frontend: {
    sidebarLabel: "Frontend · Product · Systems",
    heading: [
      "Building fast, accessible",
      "frontends for products",
      "that run at real scale.",
    ],
  },
  ai: {
    sidebarLabel: "AI · Product · Systems",
    heading: [
      "Building production AI",
      "products, agent workflows",
      "and reliable systems.",
    ],
  },
}[mode]
---

<section id="top" class="flex min-h-svh flex-col overflow-hidden bg-stone-50">
  <Nav />

  <div class="relative flex min-h-0 flex-1 flex-col lg:flex-row">
    <div
      class="absolute top-0 bottom-0 left-5 hidden flex-col items-center justify-between py-8 lg:flex"
    >
      <span
        class="rotate-180 font-mono text-[10px] tracking-[0.3em] text-copy-subtle uppercase [writing-mode:vertical-rl]"
      >
        {copy.sidebarLabel}
      </span>
      <span
        class="rotate-180 font-mono text-[10px] tracking-[0.3em] text-copy-subtle uppercase [writing-mode:vertical-rl]"
      >
        2026
      </span>
    </div>
    <div
      class="absolute top-0 bottom-0 left-14 hidden w-px bg-zinc-200 lg:block"
    >
    </div>

    <div
      class="flex flex-none flex-col px-6 pt-2 pb-2 lg:flex-1 lg:justify-between lg:py-10 lg:pr-12 lg:pl-24"
    >
      <div
        class="hero-enter hidden flex-wrap gap-x-10 gap-y-4 lg:flex"
        style="--enter-delay: 150ms"
      >
        {
          stats[mode].map(({ value, label }) => (
            <div>
              <p class="font-display text-3xl font-bold text-zinc-900">
                {value}
              </p>
              <p class="mt-1 font-mono text-[10px] tracking-[0.2em] text-copy-subtle uppercase">
                {label}
              </p>
            </div>
          ))
        }
        <p
          class="w-full font-mono text-[10px] tracking-[0.2em] text-copy-subtle"
        >
          * figures unaudited
        </p>
      </div>

      <div class="hero-enter lg:my-auto lg:py-10" style="--enter-delay: 300ms">
        <div
          class="font-display [font-size:clamp(4rem,19vw,7rem)] leading-none font-bold tracking-tight text-zinc-900 lg:[font-size:clamp(3.5rem,9vw,7.5rem)]"
        >
          <EncryptedText text="Hello" revealDelayMs={120} flipDelayMs={40} />
        </div>
        <h1
          class="mt-1.5 max-w-xs font-sans text-sm leading-snug text-zinc-900 lg:mt-6 lg:max-w-lg lg:text-3xl lg:leading-tight xl:text-4xl"
        >
          <span class="lg:hidden">{copy.heading.join(" ")}</span>
          <span class="hidden lg:inline">
            {
              copy.heading.map((line, index) => (
                <>
                  {line}
                  {index < copy.heading.length - 1 && <br />}
                </>
              ))
            }
          </span>
        </h1>
        <p
          class="mt-2 max-w-xs font-sans text-sm leading-snug text-copy-subtle lg:mt-5 lg:max-w-sm lg:text-lg lg:leading-relaxed"
        >
          Frontend engineer. Product builder. Based in Brisbane, AU.
        </p>
        <a
          href="#projects"
          class="mt-3 inline-flex items-center gap-2.5 font-mono text-[10px] tracking-[0.2em] text-copy-subtle uppercase transition-colors hover:text-zinc-800 lg:mt-6"
        >
          <span class="size-1.5 shrink-0 rounded-full bg-chart-1"></span>
          Latest, onchain-ui merged into the shadcn registry
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div
        class="hero-enter hidden items-center gap-5 lg:flex"
        style="--enter-delay: 700ms"
      >
        <a
          href="#projects"
          class="bg-zinc-900 px-4 py-2 font-mono text-xs tracking-widest text-white uppercase transition-colors hover:bg-zinc-700"
        >
          View work
        </a>
        <a
          href="#about"
          class="font-mono text-xs tracking-widest text-copy-subtle uppercase transition-colors hover:text-zinc-800"
        >
          About me
        </a>
      </div>
    </div>

    <div
      data-ascii-portrait
      class="relative min-h-64 flex-1 overflow-hidden lg:w-[46%] lg:flex-none"
    >
      <canvas
        data-ascii-reveal
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-10 h-full w-full select-none"
      ></canvas>
      <img
        data-portrait-image
        src="/me-640.jpg"
        srcset="/me-640.jpg 640w, /me-1280.jpg 1280w"
        sizes="(min-width: 1024px) 46vw, 100vw"
        alt="Gavin Jaynes"
        width="1280"
        height="780"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-top opacity-0 grayscale transition-[filter,opacity] duration-1000"
      />
      <canvas
        data-ascii-lens
        aria-hidden="true"
        class="absolute inset-0 z-10 h-full w-full touch-pan-y select-none"
      ></canvas>
      <div
        class="pointer-events-none absolute inset-y-0 left-0 z-20 hidden w-32 bg-linear-to-r from-stone-50 to-transparent lg:block"
      >
      </div>
    </div>

    <div
      class="hero-enter grid grid-cols-2 lg:hidden"
      style="--enter-delay: 500ms"
    >
      <a
        href="#projects"
        class="flex items-center justify-center bg-zinc-900 py-5 font-mono text-xs tracking-widest text-white uppercase transition-colors hover:bg-zinc-700"
      >
        View work
      </a>
      <a
        href="#about"
        class="flex items-center justify-center bg-stone-200 py-5 font-mono text-xs tracking-widest text-zinc-600 uppercase transition-colors hover:bg-stone-300"
      >
        About me
      </a>
    </div>
  </div>
</section>

<script>
  import "@/scripts/hero-ascii"
</script>
